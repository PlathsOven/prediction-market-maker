{
  "name": "prediction-market-maker",
  "version": "0.1.0",
  "description": "Open-source prediction market maker bots in TypeScript. They price each market from Polymarket and Kalshi or a live feed, then quote two-sided books on Rizon's 50/50 horizon contracts.",
  "keywords": [
    "prediction-markets",
    "market-making",
    "market-maker",
    "polymarket",
    "kalshi",
    "trading-bot",
    "algorithmic-trading",
    "quantitative-finance",
    "order-book",
    "forecasting",
    "bitcoin",
    "elections",
    "rizon"
  ],
  "homepage": "https://github.com/PlathsOven/prediction-market-maker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PlathsOven/prediction-market-maker.git"
  },
  "bugs": {
    "url": "https://github.com/PlathsOven/prediction-market-maker/issues"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "read": "bun src/read.ts",
    "test": "bun test",
    "check": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
